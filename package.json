{
  "name": "de-interview-handbook",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20.0"
  },
  "scripts": {
    "dev": "pnpm --filter @deih/website start",
    "build": "pnpm --filter @deih/website build",
    "serve": "pnpm --filter @deih/website serve",
    "questions": "node scripts/build-questions.ts && node scripts/check-content.ts",
    "test": "node --test \"scripts/*.test.ts\" \"apps/website/src/**/*.test.ts\"",
    "typecheck": "tsc -p scripts && pnpm --filter @deih/website typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data": "python datasets/generate.py",
    "verify:sql": "python scripts/verify_sql.py",
    "verify:python": "python scripts/verify_python.py"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "markdown-it": "15.0.3",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "yaml": "2.9.1"
  },
  "type": "module"
}
